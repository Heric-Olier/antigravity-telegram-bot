# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Allowed Telegram User ID (from @userinfobot)
TELEGRAM_ALLOWED_USER_ID=

# Bot locale: supported locale code (default: en)
# Supported: en, es
BOT_LOCALE=en

# Speech-to-text (STT) API key — Groq: https://console.groq.com
STT_API_KEY=

# Path to the Google Antigravity CLI binary (e.g. /usr/local/bin/agy)
AGY_BIN=

# Working directory the bot opens agy sessions in (e.g. /home/user/projects)
AGY_WORKSPACE_DIR=

# agy autonomy: YOLO skips interactive permission prompts (default: true)
# AGY_YOLO=true
# Max time for one agy turn (default: 3600s; 0 = wait forever)
# AGY_PRINT_TIMEOUT=3600s
# Optional default model id (the /model menu overrides it)
# AGY_DEFAULT_MODEL=

# Voice replies: TTS mode is seeded via INITIAL_SETTINGS_PRESET in the app-home .env
# (TTS provider defaults to edge, free — no API key needed).

# Whisper-compatible speech-to-text endpoint (Groq: https://api.groq.com/openai/v1/audio/transcriptions)
STT_API_URL=

# STT model (default: whisper-large-v3-turbo)
STT_MODEL=whisper-large-v3-turbo

# STT language hint ISO-639-1 code (default: es)
STT_LANGUAGE=es

# Optional: logging level (debug, info, warn, error) and TTS voice hint
# LOG_LEVEL=info
# TTS_VOICE=alloy
